{
  "name": "jevsume",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "jevsume-mcp": "./dist/jevsume-mcp.mjs"
  },
  "files": [
    "dist/jevsume-mcp.mjs",
    "skills/jevsume-resume",
    "readme.md"
  ],
  "scripts": {
    "dev": "vite",
    "predev": "wrangler d1 migrations apply jevsume --local",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "uat": "vitest run --config vitest.uat.config.ts",
    "typecheck": "tsc -b --pretty false",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply jevsume --local",
    "mcp:build": "node scripts/build-mcp.mjs",
    "mcp": "pnpm mcp:build && node dist/jevsume-mcp.mjs",
    "prepare": "node scripts/build-mcp.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.55.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.134.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}

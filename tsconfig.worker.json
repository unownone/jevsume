{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["worker", "packages/jev", "test", "shared", "mcp"],
  "exclude": [
    "mcp/cli.ts",
    "mcp/stdio.ts",
    "test/mcp-cli.test.ts",
    "test/mcp-skill.test.ts",
    "test/**/*.test.tsx",
    "test/setup-dom.ts",
    "test/design-tokens.test.ts",
    "test/site-app-lazy.test.ts"
  ]
}
